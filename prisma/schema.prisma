generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RepairStatus {
  NEW
  NEEDS_REVIEW
  MISSING_INFO
  READY_FOR_PICKUP
  AWB_PREPARED
  PICKUP_SCHEDULED
  RECEIVED
  DIAGNOSIS
  WARRANTY_CHECK
  IN_REPAIR
  WAITING_PARTS
  REPAIRED
  RETURN_SHIPPING
  CLOSED
  CANCELLED
}

enum EquipmentCategory {
  PRESSURE_WASHER
  CHAINSAW
  BRUSHCUTTER
  GENERATOR
  LAWN_MOWER
  PUMP
  POWER_TOOL
}

enum AttachmentKind {
  EQUIPMENT_PHOTO
  DEFECT_PHOTO
  WARRANTY_DOCUMENT
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         String          @default("ADMIN")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  notes        InternalNote[]
  histories    StatusHistory[]
}

model Customer {
  id        String          @id @default(cuid())
  fullName  String
  phone     String
  whatsapp  String
  email     String?
  createdAt DateTime        @default(now())
  requests  RepairRequest[]
}

model Address {
  id          String         @id @default(cuid())
  county      String
  city        String
  street      String
  number      String
  postalCode  String?
  details     String?
  pickupNotes String?
  request     RepairRequest?
}

model Equipment {
  id                     String            @id @default(cuid())
  category               EquipmentCategory
  brand                  String
  model                  String
  serialNumber           String?
  purchaseDate           DateTime?
  purchaseStore          String?
  accessories            String?
  fuelTankEmptyConfirmed Boolean           @default(false)
  request                RepairRequest?
}

model RepairRequest {
  id                    String       @id @default(cuid())
  publicCode            String       @unique
  year                  Int
  sequence              Int
  status                RepairStatus @default(NEW)
  repairType            String       @default("WARRANTY")
  diagnosisFree         Boolean      @default(true)
  shippingPaidByCompany Boolean      @default(true)
  faultDescription      String
  warrantyDocumentGiven Boolean      @default(true)
  gdprConsent           Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  addressId   String    @unique
  address     Address   @relation(fields: [addressId], references: [id])
  equipmentId String    @unique
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  attachments     Attachment[]
  statusHistory   StatusHistory[]
  internalNotes   InternalNote[]
  courierShipment CourierShipment?

  @@unique([year, sequence])
  @@index([status])
  @@index([createdAt])
}

model Attachment {
  id           String         @id @default(cuid())
  kind         AttachmentKind
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  diskPath     String
  uploadedAt   DateTime       @default(now())
  requestId    String
  request      RepairRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model StatusHistory {
  id          String        @id @default(cuid())
  fromStatus  RepairStatus?
  toStatus    RepairStatus
  note        String?
  createdAt   DateTime      @default(now())
  requestId   String
  request     RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedById String?
  changedBy   User?         @relation(fields: [changedById], references: [id])

  @@index([requestId])
}

model InternalNote {
  id        String        @id @default(cuid())
  body      String
  createdAt DateTime      @default(now())
  requestId String
  request   RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])

  @@index([requestId])
}

model CourierShipment {
  id           String        @id @default(cuid())
  awbToService String?
  awbReturn    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  requestId    String        @unique
  request      RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}
